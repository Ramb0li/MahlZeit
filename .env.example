# ─── Pflicht für Rezept-Import (URL + Screenshot) ────────────────────────────
# Anthropic API-Key — https://console.anthropic.com → Settings → API Keys
# Modell: claude-haiku-4-5-20251001 (sehr günstig, ~$0.001 pro Rezept-Import)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Pflicht für E-Mail-Versand (Bestätigung + Einladungen) ──────────────────
# Resend API-Key — https://resend.com → API Keys (kostenloser Tier: 100 Mails/Tag)
# Lokal ohne Key: Links werden in die Server-Konsole geloggt
RESEND_API_KEY=re_...
# Verifizierte Absender-Adresse bei Resend (Domain muss verifiziert sein)
FROM_EMAIL=MahlZeit <noreply@deine-domain.ch>
# Basis-URL der App (für Links in den E-Mails)
APP_URL=http://localhost:3000

# ─── Optional: Upstash Redis (Produktion auf Vercel) ─────────────────────────
# Ohne diese Vars läuft die App im Local-File-Modus (data/*.json).
# Mit Vars läuft sie gegen Upstash — https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE

# ─── Optional: Stripe (für bezahlte Pläne) ───────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_LIFETIME=price_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Lokal testen: stripe listen --forward-to localhost:3000/api/stripe/webhook

# ─── Optional: Vercel Blob (Bild-Upload via Admin-Panel) ─────────────────────
# Rezeptbilder werden zu Vercel Blob hochgeladen und als CDN-URL gespeichert.
# Token erstellen: vercel.com → Storage → Blob Store anlegen → Token kopieren
# Ohne diesen Token schlägt der Bild-Upload im Admin-Panel fehl.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Optional: Session-Signierung ────────────────────────────────────────────
# Wenn leer/weggelassen wird ein Dev-Fallback-Secret verwendet (NICHT für Produktion!)
# In Produktion zwingend setzen — sonst sind alle Sessions kompromittierbar.
# Tipp: openssl rand -base64 32
# JWT_SECRET=dein-zufaelliger-secret-hier
